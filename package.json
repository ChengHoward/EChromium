{
  "name": "echromium",
  "version": "0.1.0",
  "private": true,
  "description": "A modern desktop browser built on custom Electron",
  "main": "dist/main.cjs",
  "author": "Howard",
  "scripts": {
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "dev": "node scripts/start.mjs --dev",
    "start": "npm run build && node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "node scripts/test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "review:ui": "npm run build && node scripts/review-ui.mjs"
  },
  "dependencies": {
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@vitejs/plugin-vue": "5.2.1",
    "electron": "https://github.com/ChengHoward/edist/releases/download/v45.0.0-desktop.3/electron-45.0.0-desktop.3.tgz",
    "esbuild": "0.25.0",
    "prettier": "3.5.3",
    "typescript": "5.7.2",
    "vite": "6.2.0",
    "vue-tsc": "2.2.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
